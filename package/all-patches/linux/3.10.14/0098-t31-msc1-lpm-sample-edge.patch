t31: apply MSC1 LPM read sample-edge shift (LPM_SMP_SEL) at <=25MHz

The Hi3861L on MSC1 needs the shifted read sample point even at 24MHz or
CMD53 reads CRC-error; stock only sets it above 25MHz. Extend to MSC1.

--- a/drivers/mmc/host/jzmmc_v12.c
+++ b/drivers/mmc/host/jzmmc_v12.c
@@ -1384,7 +1384,7 @@
 
 		msc_writel(host, CLKRT, clkrt);
 
-		if (clk_set > 25000000)
+		if (clk_set > 25000000 || host->index == 1)
 			lpm = (0x2 << LPM_DRV_SEL_SHF) | LPM_SMP_SEL;
 
 		if(host->pdata->sdio_clk) {
