#!/bin/sh
# Hi3861L (CG721): chip does the Wi-Fi association and DHCP itself;
# hinl sends the credentials and copies the chip's address to wlan0.
case "$1" in
	start)
		[ -f /etc/hinl.conf ] || exit 0
		( /usr/bin/hinl up > /tmp/hinl.log 2>&1 ) &
		;;
	stop)
		ifconfig wlan0 down 2>/dev/null
		;;
esac
exit 0
